# Copy to .env to override the local defaults used by docker-compose.yml.
# These are non-secret local development values only.
POSTGRES_DB=finance_tracker
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
# Host ports. PostgreSQL is published on 55432 so it doesn't clash with a locally installed
# PostgreSQL on 5432; inside the Compose network it still listens on 5432.
POSTGRES_HOST_PORT=55432
API_HOST_PORT=5080
# JWT signing key for the API container (at least 32 bytes). The compose default is a
# local-development-only value; never reuse it in a deployed environment.
# JWT_SIGNING_KEY=
